PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Supabase / Neon connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalyst_db?schema=public

# Authentication Security
JWT_SECRET=catalyst_hackathon_super_secure_jwt_secret_key_2026_x99
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# Cloudinary Media Storage (For tablet photos & caretaker voice recordings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis & Queue (Optional - automatically falls back to in-memory if not provided)
REDIS_URL=

# Adaption AI (Primary AI Engine using participant credits)
ADAPTION_AI_API_KEY=
ADAPTION_AI_BASE_URL=https://api.adaptionlab.com/v1
ADAPTION_AI_MODEL=adaption-vision-pro

# Google Gemini (Secondary Fallback)
GEMINI_API_KEY=
